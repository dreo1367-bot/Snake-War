<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BrickBreaker3D</AssemblyName>
    <RootNamespace>BrickBreaker3D</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Self-contained single-file publish defaults (can be overridden from CLI) -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="shaders\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
